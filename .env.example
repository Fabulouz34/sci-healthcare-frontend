# Backend API (indexer read model).
# A production build refuses to start until the eight required values below
# are set (this one, _STELLAR_NETWORK, _SOROBAN_RPC_URL, _NETWORK_PASSPHRASE
# and the four contract ids), naming every one that is missing: see
# next.config.ts (#76).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Opt-in testnet first-voucher fees. Enable only after deploying the sign-only
# sponsor endpoint under the API URL. See docs/sponsored-fees.md.
# NEXT_PUBLIC_SPONSORED_FEES=true

# Stellar network. `public` means mainnet: the header badge shows Mainnet
# and every testnet-only feature (the faucet, its notices, the footer
# disclaimer) is hidden. Anything else is treated as a testnet build.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract ids, from sci-healthcare-contracts/scripts/deploy.sh
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_VOUCHER_CONTRACT_ID=
NEXT_PUBLIC_RECEIPT_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=
# Testnet demo only: from scripts/deploy-faucet.sh, and the USDC issuer
# (USDC_ISSUER in deployments/testnet.env) so users can add the asset.
NEXT_PUBLIC_FAUCET_CONTRACT_ID=
NEXT_PUBLIC_USDC_ISSUER=

# Cookieless usage analytics (Plausible). Leave unset to disable entirely:
# no script is loaded and no events are sent.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=app.example.com

# Error reporting (Sentry). Leave unset to disable entirely: the SDK is
# never initialised and no report leaves the browser.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<host>/<project>

# Mobile wallets through WalletConnect (#163). Create a project at
# https://cloud.reown.com and paste its id to offer WalletConnect alongside
# browser-extension and passkey wallets. Leave unset and the module (and its
# AppKit bundle) is never loaded.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Content-Security-Policy (#73), read by next.config.ts at build time. The
# policy is sent as report-only until this is set, so a deployment can be
# checked against real wallets first; `CSP_ENFORCE=1` sends the enforcing
# header instead, and refuses anything not in the allow-list. Redeploy after
# changing it — headers are baked in at build time, like every value above.
# CSP_ENFORCE=1
